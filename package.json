{
  "name": "@local/dsh-wolfram-mcp",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Detect the local Wolfram installation, register its MCP server from a persisted kernel-generated configuration, and manage Wolfram agent skills.",
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "src/Skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "rebuild": "node scripts/build.mjs --force",
    "verify": "node scripts/verify.mjs",
    "clean": "node scripts/build.mjs --clean",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.2-rc.3"
  }
}
